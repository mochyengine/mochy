# -----------------------------------------------------------------------------
# Build output
# Patterns starting with "/" only match in the repository root, so they never
# hide vendored files inside dependencies/.
# -----------------------------------------------------------------------------

# CMake build directories (CLion: cmake-build-*, CLI/presets: build*/, out/)
/cmake-build-*/
/build*/
/Build/
/out/

# CMake files written into the source tree (in-source builds)
/CMakeCache.txt
/CMakeFiles/
/cmake_install.cmake
/install_manifest.txt
/compile_commands.json
/Makefile
/build.ninja
/.ninja_*

# Personal CMake presets (CMakePresets.json is versioned)
CMakeUserPresets.json

# Release packages, test output and runtime logs
/dist/
/Testing/
/*.log

# -----------------------------------------------------------------------------
# Compiler and linker artifacts (only in our own code, not in dependencies/)
# -----------------------------------------------------------------------------
/src/**/*.o
/src/**/*.obj
/src/**/*.a
/src/**/*.lib
/src/**/*.so
/src/**/*.dll
/src/**/*.exe
/src/**/*.pdb
/src/**/*.ilk

# -----------------------------------------------------------------------------
# Tooling caches
# -----------------------------------------------------------------------------
.cache/
*.swp
*.tmp
*~

# -----------------------------------------------------------------------------
# IDEs and editors
# -----------------------------------------------------------------------------
.idea/
.obsidian/
.vs/
.vscode/
